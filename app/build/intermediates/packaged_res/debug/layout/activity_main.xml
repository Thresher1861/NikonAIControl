<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D">

    <ImageView
        android:id="@+id/ivLiveView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter" />

    <ImageView
        android:id="@+id/ivOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.5"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:background="#80000000"
        android:orientation="horizontal"
        android:padding="4dp">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="Ожидание Nikon..."
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <Button android:id="@+id/btnModeNormal" android:layout_width="wrap_content" android:layout_height="36dp" android:text="Обычн" android:textSize="11sp" />
        <Button android:id="@+id/btnModeDouble" android:layout_width="wrap_content" android:layout_height="36dp" android:text="2x" android:textSize="11sp" />
        <Button android:id="@+id/btnModeSplit" android:layout_width="wrap_content" android:layout_height="36dp" android:text="1/2" android:textSize="11sp" />
        <Button android:id="@+id/btnModeAi" android:layout_width="wrap_content" android:layout_height="36dp" android:text="ИИ" android:textSize="11sp" />
        <Button android:id="@+id/btnPeaking" android:layout_width="wrap_content" android:layout_height="36dp" android:text="Пикинг" android:textSize="11sp" />
        <Button android:id="@+id/btnZebra" android:layout_width="wrap_content" android:layout_height="36dp" android:text="Зебра" android:textSize="11sp" />
        <Button android:id="@+id/btnGrid" android:layout_width="wrap_content" android:layout_height="36dp" android:text="Сетка" android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="8dp"
        android:background="#80000000"
        android:orientation="horizontal"
        android:padding="4dp">

        <Button android:id="@+id/btnIso" android:layout_width="wrap_content" android:layout_height="36dp" android:text="ISO" android:textSize="11sp" />
        <Button android:id="@+id/btnShutterSpeed" android:layout_width="wrap_content" android:layout_height="36dp" android:text="Выд" android:textSize="11sp" />
        <Button android:id="@+id/btnAperture" android:layout_width="wrap_content" android:layout_height="36dp" android:text="Диаф" android:textSize="11sp" />
        <Button android:id="@+id/btnWb" android:layout_width="wrap_content" android:layout_height="36dp" android:text="ББ" android:textSize="11sp" />
        <Button android:id="@+id/btnGallery" android:layout_width="wrap_content" android:layout_height="36dp" android:text="Фото" android:textSize="11sp" />

        <EditText
            android:id="@+id/etAiPrompt"
            android:layout_width="140dp"
            android:layout_height="36dp"
            android:hint="Запрос ИИ..."
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:textSize="12sp" />

        <Button android:id="@+id/btnAiApply" android:layout_width="wrap_content" android:layout_height="36dp" android:text="ОК" android:textSize="11sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnShutter"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="16dp"
        android:text="REC"
        android:textColor="#FFFFFF" />
</FrameLayout>