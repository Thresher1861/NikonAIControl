<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D">
    <ImageView
        android:id="@+id/ivLiveView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter" />

    <ImageView
        android:id="@+id/ivGhost"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.45"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <ru.dimar.nikonaicontrol.ZebraOverlayView
        android:id="@+id/zebraView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ru.dimar.nikonaicontrol.FocusView
        android:id="@+id/focusView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="10dp"
        android:background="#99000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="4dp">

        <Button
            android:id="@+id/btnMenu"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:backgroundTint="#37474F"
            android:text="МЕНЮ"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:text="[v26] Nikon D3400"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="20dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnVideo"
            android:layout_width="68dp"
            android:layout_height="48dp"
            android:backgroundTint="#424242"
            android:text="VID"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnAi"
            android:layout_width="68dp"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="#7B1FA2"
            android:text="AI"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnShutter"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#D32F2F"
            android:text="REC"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnAf"
            android:layout_width="68dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#1976D2"
            android:text="AF"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="bottom"
        android:background="#CC121212"
        android:orientation="horizontal">

        <ru.dimar.nikonaicontrol.WheelSelectorView
            android:id="@+id/wheelShutter"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <ru.dimar.nikonaicontrol.WheelSelectorView
            android:id="@+id/wheelAperture"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <ru.dimar.nikonaicontrol.WheelSelectorView
            android:id="@+id/wheelIso"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
    </LinearLayout>
</FrameLayout>